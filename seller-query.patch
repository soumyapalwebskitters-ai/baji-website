+.query-filters{display:flex;gap:16px;align-items:end;flex-wrap:wrap;margin:24px 0}.query-filters>.field:first-child{flex:1;min-width:220px}.query-filters .field{display:grid;gap:8px}.query-filters input,.query-filters select{min-height:42px}.query-count{margin-bottom:18px}.query-record{border:1px solid var(--line,#39414a);border-radius:10px;margin:14px 0;overflow:hidden}.query-record>summary{display:flex;align-items:center;gap:18px;cursor:pointer;padding:20px;list-style:none}.query-record>summary>span:first-child{flex:1;min-width:0}.query-record>summary>span:first-child>span{display:block;margin-top:6px;font-size:.85rem}.query-record>summary:focus-visible{outline:2px solid currentColor;outline-offset:-3px}.query-status{text-transform:capitalize;font-size:.8rem;border:1px solid currentColor;border-radius:5px;padding:4px 8px}.query-record-body{padding:0 20px 20px}.query-contact-details{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding:20px 0;border-top:1px solid var(--line,#39414a)}.query-contact-details dt{font-size:.8rem;opacity:.7;margin-bottom:6px}.query-contact-details dd{margin:0;overflow-wrap:anywhere}.query-products{overflow-x:auto}.query-products table{width:100%;min-width:620px;border-collapse:collapse}.query-products caption{text-align:left;font-weight:600;padding:12px 0}.query-products th,.query-products td{text-align:left;padding:12px;border-bottom:1px solid var(--line,#39414a)}.query-pages{display:flex;align-items:center;justify-content:center;gap:20px;margin-top:24px}@media(max-width:650px){.query-contact-details{grid-template-columns:1fr}.query-record>summary{flex-wrap:wrap;padding:16px;gap:12px}.query-record>summary>span:first-child{flex-basis:100%}.query-record-body{padding:0 16px 16px}.query-filters>.field:first-child{min-width:100%}}
